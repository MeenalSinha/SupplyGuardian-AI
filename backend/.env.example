# SupplyGuardian AI - Backend Environment Variables
# Copy this to .env and fill in your values

# App
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-secure-random-string-in-production

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql+asyncpg://supplyguardian:supplyguardian@localhost:5432/supplyguardian

# Redis
REDIS_URL=redis://localhost:6379/0

# AI - OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# AI - Anthropic (optional fallback)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - Frontend URLs
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Object Storage (S3-compatible - AWS S3, MinIO, etc.)
STORAGE_ENDPOINT=https://s3.amazonaws.com
STORAGE_ACCESS_KEY=your-access-key
STORAGE_SECRET_KEY=your-secret-key
STORAGE_BUCKET=supplyguardian-documents

# External APIs (all optional - system works without them)
OFAC_API_KEY=your-ofac-api-key
NEWS_API_KEY=your-news-api-key
WEATHER_API_KEY=your-weather-api-key

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key

# UiPath Integration
UIPATH_CLIENT_ID=your-uipath-client-id
UIPATH_CLIENT_SECRET=your-uipath-client-secret
UIPATH_TENANT_URL=https://your-tenant.uipath.com
